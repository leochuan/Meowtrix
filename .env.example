# ============================================================
# Cat Escape Monitor - Environment Template
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env

# --- Network ---
MINI_IP=192.168.1.100
RTSP_URL=rtsp://192.168.1.101:8080/h264_pcm.sdp

# --- Service Ports ---
FRIGATE_PORT=5001
MQTT_PORT=1883
ZONE_PICKER_PORT=8090

# --- MQTT ---
MQTT_HOST=localhost

# --- Bark Push Notification ---
BARK_SERVER=https://api.day.app
BARK_DEVICE_KEY=your_bark_device_key_here

# --- Monitoring Behavior ---
TARGET_ZONE=door_zone
EVENT_COOLDOWN=30
